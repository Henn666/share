以下是針對此邏輯重新設計的可靠 Python 腳本：

Python
import re

def is_float(val):
    try:
        float(val)
        return True
    except ValueError:
        return False

def parse_pt_rpt_robust(file_path):
    parsed_data = []
    
    # 建立正則表達式：捕捉行首的字串，若後方有帶括號的 (cell) 則一併捕捉
    # 範例匹配："U_CORE/U_ALU/out", 或 "U_CORE/U_ALU/out (INVX4)"
    point_re = re.compile(r'^(\S+(?:\s+\([^)]+\))?)')
    
    with open(file_path, 'r', encoding='utf-8') as f:
        for line in f:
            original_line = line.rstrip('\n')
            work_line = original_line.strip()
            
            # 略過分隔線或空行
            if not work_line or work_line.startswith('---') or work_line.startswith('Cap'):
                continue
                
            row_data = {
                "Point": None,
                "Incr": None,
                "Marker": None, # 例如 '*', 'H' 等 violation 標記
                "Path_Value": None,
                "Dir": None,
                "Voltage": None,
                "Middle_Raw": [] # 存放中間不穩定的欄位
            }
            
            # 1. 處理左段 (Point row)
            match = point_re.match(work_line)
            if match:
                row_data["Point"] = match.group(1)
                # 將左段名稱從字串中移除，剩下的就是純數值與標記的區域
                work_line = work_line[len(row_data["Point"]):].strip()
            
            # 2. 將剩下的字串依空白分割成 Token 陣列
            tokens = work_line.split()
            if not tokens:
                if row_data["Point"]:
                    parsed_data.append(row_data)
                continue

            # 3. 處理右段 (從尾部倒序取值)
            # 判斷是否為標準的 Timing Path 行 (倒數第二個 token 應該是 r 或 f)
            if len(tokens) >= 3 and tokens[-2] in ['r', 'f']:
                try:
                    row_data["Voltage"] = float(tokens[-1])
                    row_data["Dir"] = tokens[-2]
                    row_data["Path_Value"] = float(tokens[-3])
                    
                    # 判斷倒數第 4 個位置是 marker 還是 Incr
                    if is_float(tokens[-4]):
                        # 如果是數字，代表沒有 marker，此值即為 Incr
                        row_data["Incr"] = float(tokens[-4])
                        middle_end_idx = -4
                    else:
                        # 如果不是數字，代表是 marker (如 '*' 或 'H')
                        row_data["Marker"] = tokens[-4]
                        row_data["Incr"] = float(tokens[-5])
                        middle_end_idx = -5
                        
                    # 4. 中間剩餘的 tokens 全部原樣保留，不強制對齊
                    row_data["Middle_Raw"] = tokens[:middle_end_idx]
                    
                except (ValueError, IndexError):
                    # 若轉型失敗，退回 raw 模式
                    row_data["Middle_Raw"] = tokens
            else:
                # 處理非標準行 (例如只有 Incr 或是 summary 行)
                row_data["Middle_Raw"] = tokens
                
            parsed_data.append(row_data)
            
    return parsed_data

# 使用範例：
# results = parse_pt_rpt_robust("your_report.rpt")
# for r in results:
